# PetPrep website — production image from an output CI already built (2026-11-03, David: faster deploys).
#
# CI runs `next build` ONCE, inside node:22-alpine (the same libc as this image, so sharp's native
# binary in .next/standalone/node_modules matches), and this file only packages the result —
# no second build, no build cache to export. The full-build ../Dockerfile stays the manual fallback.
#
# Layers: the traced node_modules (changes only with dependencies) before the rest of the standalone
# server and the prerendered pages, so a server pull downloads only what changed. CI sets every
# file's mtime to a fixed date first, so identical files give an identical layer.
#
# Build context: the repository root after `npm run build`.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
# Non-root user
RUN addgroup -S -g 1001 web && adduser -S -u 1001 -G web web
COPY --chown=web:web .next/standalone/node_modules ./node_modules
COPY --chown=web:web .next/standalone/package.json .next/standalone/server.js ./
COPY --chown=web:web .next/standalone/.next ./.next
COPY --chown=web:web .next/static ./.next/static
COPY --chown=web:web public ./public
# Fonts and the mark used to render Open Graph images at runtime.
COPY --chown=web:web src/og ./src/og
# Next.js image cache (breed portraits etc.) — a named volume in deploy/compose.yaml keeps it
# across deploys; created here so the volume starts owned by `web`.
RUN mkdir -p /app/.next/cache && chown -R web:web /app/.next/cache
USER web
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:3000/robots.txt || exit 1
CMD ["node", "server.js"]
