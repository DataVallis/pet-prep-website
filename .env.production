# Build-time switches of the production build (`next build` reads this file; CI builds the image from it).
# NEXT_PUBLIC_* values are inlined into the browser bundle: never put a secret here.
# Changing a line = a real change of the git tree, so CI builds a new image (it reuses images per tree).
# README.md → "Gift voucher" explains each value.

# Gift voucher pages (/gift, /gift/thanks, /redeem and their localized twins in all 15 languages). Exactly 1 = on, anything else = off.
# TODO(David): set to 1 only after the app is in the stores, the Lemon Squeezy product exists and the server switch is on.
NEXT_PUBLIC_FEATURE_GIFT=0

# Lemon Squeezy checkout URL of the gift product (https). Empty while the pages are on = the buy button shows "Coming soon".
# TODO(David): paste the checkout URL of "PetPrep darilni bon" here.
NEXT_PUBLIC_LS_GIFT_URL=

# API the redeem and sign-in requests go to. Empty = https://api.petprep.si
NEXT_PUBLIC_PETPREP_API_URL=

# Pet Promise Kit page (/promise-kit and its localized twins in all 15 languages; M6-S02). Exactly 1 = on, anything else (empty) = off.
# TODO(David): set to 1 after reading the kit text.
NEXT_PUBLIC_FEATURE_PROMISE_KIT=

# Lemon Squeezy checkout of the kit (https). Empty = the buy button is hidden.
NEXT_PUBLIC_LS_KIT_URL=

# Lemon Squeezy checkout of the free sample (https). Empty = the sample button and block are hidden.
NEXT_PUBLIC_LS_SAMPLE_URL=

# Google web client id for the redeem page sign-in (M6-S01b). Public identifier, not a secret. Empty = the "Continue with Google" button is hidden.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=1029107925972-6kanm5f1u2bha65ua73e4m09fbjn4cp7.apps.googleusercontent.com

# Apple Services ID for the redeem page sign-in (M6-S01b) (com.datavallis.petprep.web). Public identifier. Empty = the "Continue with Apple" button is hidden.
NEXT_PUBLIC_APPLE_SERVICES_ID=com.datavallis.petprep.web
