# Build-time switches of the production build (`next build` reads this file; CI builds the image from it).
# NEXT_PUBLIC_* values are inlined into the browser bundle: never put a secret here.
# Changing a line = a real change of the git tree, so CI builds a new image (it reuses images per tree).
# README.md → "Gift voucher" explains each value.

# Gift voucher pages (/gift, /gift/thanks, /redeem and the Slovenian twins). Exactly 1 = on, anything else = off.
# TODO(David): set to 1 only after the app is in the stores, the Lemon Squeezy product exists and the server switch is on.
NEXT_PUBLIC_FEATURE_GIFT=0

# Lemon Squeezy checkout URL of the gift product (https). Empty while the pages are on = the buy button shows "Coming soon".
# TODO(David): paste the checkout URL of "PetPrep darilni bon" here.
NEXT_PUBLIC_LS_GIFT_URL=

# API the redeem form posts to. Empty = https://api.petprep.si
NEXT_PUBLIC_PETPREP_API_URL=
